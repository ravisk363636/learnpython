# Copy to .env and adjust. Values here are safe defaults for the public demo site.

BASE_URL=https://the-internet.herokuapp.com
BROWSER=chrome
HEADLESS=true
WINDOW_WIDTH=1920
WINDOW_HEIGHT=1080
EXPLICIT_WAIT_SECONDS=15
PAGE_LOAD_TIMEOUT_SECONDS=30
REMOTE_URL=
DOWNLOAD_DIR=downloads
SCREENSHOT_DIR=screenshots
LOG_LEVEL=INFO
