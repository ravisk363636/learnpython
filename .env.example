# Copy to .env and set real values. Never commit secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://queuelite:queuelite@localhost:5432/queuelite
REDIS_URL=redis://localhost:6379/0
# Required for seed_demo (do not use this value in production)
QUEUELITE_SEED_PASSWORD=
# Email (console backend in DEBUG)
DEFAULT_FROM_EMAIL=noreply@localhost
# Optional SMS (leave blank to skip SMS; email still used in DEBUG)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
